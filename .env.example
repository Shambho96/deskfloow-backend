# Application Configuration
APP_NAME=DeskFlow Hotel PMS API
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Security Secrets (Must be changed in production)
JWT_SECRET=deskflow_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PII Encryption Secret (Must be 32 bytes base64-encoded string for AES-256)
PII_SECRET_KEY=

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Neon Cloud PostgreSQL Async Database Connection
DATABASE_URL=
SQL_ECHO=False
